# 复制为 .env 后填入；不填密钥仍可启动并使用演示模式。
STUDY_MODE=demo
DATA_DIR=data
# 默认启用登录；首个账号需从服务器本机创建，并承接原有学习资料。
AUTH_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
# HTTPS 部署时设为 true；本机 HTTP 保持 false。
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
REQUEST_TIMEOUT=60
MAX_UPLOAD_MB=200
# 本地中英文 OCR，仅识别 PDF 的扫描页，不调用模型 API。
OCR_ENABLED=true
OCR_DPI=180
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_CANDIDATES=12
RETRIEVAL_TOP_K=6
# cosine similarity，需用课程自己的标注集调优，不能视为置信概率。
MIN_SIMILARITY=0.25
CONTEXT_CHAR_BUDGET=9000
# Phase 2：限制单批原文、解析批次及 Agent 调用预算。
EXAM_BATCH_CHARS=12000
EXAM_MAX_BATCHES=20
AGENT_MAX_STEPS=6
AGENT_CONTEXT_CHARS=60000

# Phase 3 结构化生成输出上限；不是输入 Token 精确计数
GENERATION_MAX_TOKENS=8000
# 整份资料学习：分段读取上限与模型调用预算，超过预算需缩小范围。
STUDY_WINDOW_CHARS=24000
STUDY_MAX_CALLS=120
