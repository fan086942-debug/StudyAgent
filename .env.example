# 复制为 .env 后填入；不填密钥仍可启动并使用演示模式。
STUDY_MODE=demo
DATA_DIR=data
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
REQUEST_TIMEOUT=60
MAX_UPLOAD_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_CANDIDATES=12
RETRIEVAL_TOP_K=6
# cosine similarity，需用课程自己的标注集调优，不能视为置信概率。
MIN_SIMILARITY=0.25
CONTEXT_CHAR_BUDGET=9000
